# Backend environment. Copy to `.env` and fill in. NEVER commit the real .env.

# ---- Supabase (Project Settings -> API) ----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Service-role key — SERVER ONLY. Bypasses RLS; never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Database (Project Settings -> Database -> Connection string) ----
# Runtime uses the pooled connection (port 6543, pgbouncer). Migrations use the
# direct connection (port 5432). Both include your DB password.
DATABASE_URL=postgresql://postgres.your-ref:PASSWORD@aws-1-region.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.your-ref:PASSWORD@aws-1-region.pooler.supabase.com:5432/postgres

# ---- App ----
# Port the API listens on (host may override via its own PORT env).
PORT=3000
# Comma-separated allowed CORS origins = your deployed frontend URL(s).
# Local dev default is http://localhost:5173.
FRONTEND_ORIGIN=https://your-frontend-domain.com

# ---- Razorpay (Dashboard -> Settings -> API Keys) ----
# Used to create payment orders and verify payment signatures. The key id is
# public-safe (sent to the browser checkout); the secret is SERVER-ONLY.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Webhook signing secret (Dashboard -> Settings -> Webhooks, set when you create
# the webhook). Used to verify the X-Razorpay-Signature on payment.captured
# events at POST /api/v1/appointment/payment/webhook. Optional — the client-side
# verify flow still confirms payments without it.
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# ---- Whereby (Dashboard -> Configure -> API keys) ----
# Server-only key used to create a video room per ONLINE appointment once paid.
# If unset, video rooms are simply not created (booking flow still works).
WHEREBY_API_KEY=your_key

# ---- Email / SMTP (transactional reminders) ----
# Used to email patients their video-consultation join link a day before.
# If unset, emails are skipped (logged) and the rest of the app still works.
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
MAIL_FROM="Physiotic <no-reply@kinex.health>"

# ---- Cron ----
# Shared secret guarding the reminder endpoint (POST /api/v1/cron/appointment-
# reminders). The external scheduler must send it as the `x-cron-secret` header.
CRON_SECRET=a-long-random-string
