// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PATIENT
  DOCTOR
  ADMIN
}

enum DoctorStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum AppointmentMode {
  ONLINE
  HOME_VISIT
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  VERIFIED
  FAILED
  REFUNDED
}

// Mirrors a Supabase auth.users row. The id IS the auth user's id (auth.users.id);
// it is never generated here — it is set from the verified access token's `sub`.
model Profile {
  id        String   @id @db.Uuid
  name      String
  email     String   @unique
  role      UserRole @default(PATIENT)
  phone     String?
  photoUrl  String?  @map("photo_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  patient         Patient?
  doctor          Doctor?  @relation("DoctorProfile")
  verifiedDoctors Doctor[] @relation("DoctorVerifier")

  @@map("profiles")
}

model Patient {
  id          String    @id @default(uuid())
  profileId   String    @unique @map("profile_id") @db.Uuid
  dateOfBirth DateTime? @map("date_of_birth") @db.Date
  address     String?
  // Geo-coordinates of the patient's address, captured at booking time so a
  // doctor on a home visit can open the exact spot in their maps app.
  latitude    Float?
  longitude   Float?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  profile      Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@map("patients")
}

model Doctor {
  id             String       @id @default(uuid())
  profileId      String       @unique @map("profile_id") @db.Uuid
  specialization String
  licenseNumber  String       @unique @map("license_number")
  // Self-set consultation fee in whole rupees (INR). Null until the doctor sets it.
  consultationFee Int?        @map("consultation_fee")
  status         DoctorStatus @default(PENDING)
  verifiedById   String?      @map("verified_by") @db.Uuid
  verifiedAt     DateTime?    @map("verified_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  profile      Profile       @relation("DoctorProfile", fields: [profileId], references: [id], onDelete: Cascade)
  verifiedBy   Profile?      @relation("DoctorVerifier", fields: [verifiedById], references: [id])
  appointments Appointment[]
  slots        TimeSlot[]

  @@index([status])
  @@map("doctors")
}

// A bookable 1-hour slot a doctor opens up. Doctors may only create slots for
// the next 3 calendar days, excluding today. A slot is reserved (isBooked) the
// moment a patient starts a booking, and freed again if that booking is
// cancelled — so two patients can never grab the same hour.
model TimeSlot {
  id        String   @id @default(uuid())
  doctorId  String   @map("doctor_id")
  startsAt  DateTime @map("starts_at")
  isBooked  Boolean  @default(false) @map("is_booked")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  doctor      Doctor       @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  appointment Appointment?

  @@unique([doctorId, startsAt])
  @@index([doctorId, startsAt])
  @@map("time_slots")
}

model Appointment {
  id          String            @id @default(uuid())
  patientId   String            @map("patient_id")
  doctorId    String            @map("doctor_id")
  slotId      String?           @unique @map("slot_id")
  mode        AppointmentMode
  scheduledAt DateTime          @map("scheduled_at")
  status      AppointmentStatus @default(PENDING)
  notes       String?
  // Video consultation (ONLINE appointments only). Created from a Whereby meeting
  // once payment is confirmed. roomUrl is the patient's join link; hostRoomUrl is
  // the doctor's (host-privileged) link. meetingId is Whereby's id for the room.
  meetingId   String?           @map("meeting_id")
  roomUrl     String?           @map("room_url")
  hostRoomUrl String?           @map("host_room_url")
  // When the day-before join-link reminder email was sent to the patient (null
  // until sent) — prevents the reminder cron from emailing the same patient twice.
  reminderSentAt DateTime?      @map("reminder_sent_at")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  patient Patient   @relation(fields: [patientId], references: [id])
  doctor  Doctor    @relation(fields: [doctorId], references: [id])
  slot    TimeSlot? @relation(fields: [slotId], references: [id])
  payment Payment?

  @@index([patientId, scheduledAt(sort: Desc)])
  @@index([doctorId, scheduledAt(sort: Desc)])
  @@map("appointments")
}

model Payment {
  id               String        @id @default(uuid())
  appointmentId    String        @unique @map("appointment_id")
  amountPaise      BigInt        @map("amount_paise")
  // The doctor's net consultation earning (excludes gateway fee + GST, which go
  // to the gateway/govt). Null for pre-existing rows. amountPaise = total charged.
  consultationPaise BigInt?      @map("consultation_paise")
  gatewayOrderId   String?       @map("gateway_order_id")
  gatewayPaymentId String?       @map("gateway_payment_id")
  status           PaymentStatus @default(PENDING)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  appointment Appointment @relation(fields: [appointmentId], references: [id])

  @@map("payments")
}