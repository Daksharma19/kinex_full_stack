# Frontend public config. Copy to `.env` and fill in.
# These are PUBLIC-safe values (the anon key is meant to ship to browsers).
# NEVER put the Supabase service-role key here — that stays server-side only.
#
# The BUN_PUBLIC_ prefix is REQUIRED: Bun only inlines env vars with this prefix
# into the client/browser bundle. Without it you get "process is not defined".

# Same Supabase project as the backend (Project Settings → API).
BUN_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
BUN_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Base URL of the backend API (the express server in ../backend, default :3000).
BUN_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
